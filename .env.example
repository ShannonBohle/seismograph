# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Zetaris (data layer). UI origin, not port 8888. Org ID: Management -> Organisation -> ID
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# or sign in with the admin account instead of an API key:
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_EVIDENCE_DS=seismo_pg

# --- Evidence store that Zetaris federates (docker compose service evidence-db)
EVIDENCE_PG_DSN=postgresql://seismo:seismo@localhost:5433/seismograph

# --- Meterless Nightshift (primary AI provider). Token from Nightshift's Console.
# Your NVIDIA key goes in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP=seismograph
# Model ids are Nightshift routing modes, or a model id Nightshift lists in GET /v1/models.
EXTRACTOR_MODEL=meterless/auto
JUDGE_MODEL=meterless/auto
# true = fail any call that Nightshift did not serve with a Nemotron model
REQUIRE_NEMOTRON=false

# --- SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=Seismograph research your-email@example.com

# --- Runtime
SAMPLE_MODE=false
RECORD_SAMPLE=false
